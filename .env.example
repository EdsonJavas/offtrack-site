# URL pública do site (sem barra no fim). Usada em metadata, sitemap e OG.
NEXT_PUBLIC_SITE_URL=https://offtrack.com.br

# Painel /admin: senha de acesso e segredo que assina o cookie de sessão.
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SECRET=

# Vercel Blob: única fonte do catálogo e das fotos. Crie um store em
# Vercel → Storage → Blob e ligue ao projeto; a Vercel preenche esta variável sozinha.
# No .env.local ela é opcional: com o token, o ambiente local lê e GRAVA em produção.
BLOB_READ_WRITE_TOKEN=

# Desenvolvimento sem o token: espelha (somente leitura) as peças publicadas,
# lendo a rota pública do site em produção.
CATALOG_URL=https://offtrack-site.vercel.app/api/catalog

# Geração de vídeos do hero (uso futuro, só em scripts locais; nunca no site).
HIGGSFIELD_API_KEY=
